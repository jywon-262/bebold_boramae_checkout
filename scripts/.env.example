# scripts/.env 로 복사해서 실제 값을 채우세요 (scripts/.env는 .gitignore에 이미 포함되어 있어 커밋되지 않습니다)

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# anon key가 아니라 service_role key! Supabase 대시보드 > Project Settings > API 에서 확인
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NAVER_CLUB_ID=27959802
NAVER_MENU_ID=28

# 로컬에서는 이 두 값 대신 naver_login_setup.py를 한 번 실행해 로그인 세션을 저장해두면
# 자동으로 쿠키를 읽어오므로 비워둬도 됩니다. GitHub Actions 등 CI에서는 필수입니다.
# NID_AUT=
# NID_SES=
